# NAG runtime data.
# 不建议放在 Git 仓库目录下，避免 git pull / git clean / git status 受到影响。
DATA_ROOT=/opt/nag-data

# 默认只监听本机，更安全。
# 云服务器如果要直接公网访问 WebUI，可改为 0.0.0.0，并在安全组/防火墙放行端口，也可使用反向代理或CF隧道。
BIND_IP=127.0.0.1

TZ=Asia/Shanghai

GSCORE_PORT=8765
ASTRBOT_WEBUI_PORT=6185
ASTRBOT_ONEBOT_PORT=6199
NAPCAT_WEBUI_PORT=6099

# root 部署可保持 0:0；普通用户部署建议改成 id -u / id -g 的输出。
NAPCAT_UID=0
NAPCAT_GID=0

GSCORE_IMAGE=docker.cnb.cool/gscore-mirror/gsuid_core:latest
ASTRBOT_IMAGE=soulter/astrbot:latest
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest

# 国内拉取 AstrBot 镜像慢时可改用：
# ASTRBOT_IMAGE=m.daocloud.io/docker.io/soulter/astrbot:latest

GSCORE_PYTHON_INDEX=https://pypi.org/simple/
UV_NO_CONFIG=0

# 容器内访问 GitHub / PyPI 困难时可启用代理。
# GSCORE_HTTP_PROXY=http://host.docker.internal:7890
# GSCORE_HTTPS_PROXY=http://host.docker.internal:7890
# GSCORE_NO_PROXY=localhost,127.0.0.1,gscore,astrbot,napcat,.local,cnb.cool,mirrors.aliyun.com,pypi.tuna.tsinghua.edu.cn,mirrors.volces.com

# 固定 NapCat 容器 MAC，降低某些环境下重复登录/风控概率。
NAPCAT_MAC=02:42:ac:11:00:02
