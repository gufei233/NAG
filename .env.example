# NAG runtime data.
# Do not put runtime data inside the Git repository.
DATA_ROOT=/opt/nag-data

# Bind WebUIs to localhost by default. Use SSH tunnel, reverse proxy, or change
# this to 0.0.0.0 only after opening the firewall/security group intentionally.
BIND_IP=127.0.0.1

TZ=Asia/Shanghai

GSCORE_PORT=8765
ASTRBOT_WEBUI_PORT=6185
NAPCAT_WEBUI_PORT=6099

# Only used with docker-compose.botshepherd.yml.
BOTSHEPHERD_WEBUI_PORT=5111

# Root deployments can keep 0:0. Non-root deployments should use `id -u` and
# `id -g` from the host user that owns DATA_ROOT.
NAPCAT_UID=0
NAPCAT_GID=0

# Optional quick-login account. Keep the QQ data/config mounts and fixed MAC as
# well; Tencent may still require phone confirmation after some rebuilds.
NAPCAT_ACCOUNT=

# Optional: only used after copying docker-compose.mac.example.yml to
# docker-compose.override.yml. Generate a unique MAC for your own deployment.
# NAPCAT_MAC=02:xx:xx:xx:xx:xx

GSCORE_IMAGE=docker.cnb.cool/gscore-mirror/gsuid_core:latest
ASTRBOT_IMAGE=soulter/astrbot:latest
NONEBOT_IMAGE=nag-nonebot:local
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
BOTSHEPHERD_IMAGE=ghcr.io/gufei233/botshepherd:v1.2.1-docker.1

# Leave empty to generate a random first-start password in container logs.
BOTSHEPHERD_WEB_USERNAME=admin
BOTSHEPHERD_WEB_PASSWORD=

# Used by GsCore and, when selected, the NapCat GScore adapter. The installer
# generates the token and writes the same master QQ list to both sides.
GSCORE_WS_TOKEN=
NAPCAT_MASTER_QQ=

# NoneBot routes only. true loads GenshinUID; false leaves GScore handling to
# the NapCat adapter.
ENABLE_NONEBOT_GSCORE_ADAPTER=true

# QQ Official routes (docker-compose.qqofficial.yml). Keep real credentials in
# .installer/*.env or another private env file; never commit them.
QQ_APP_ID=
QQ_APP_SECRET=
# Required only by the NoneBot adapter-qq route. gscore-qqofficial obtains an
# access token from AppID + AppSecret and does not use this field.
QQ_TOKEN=
# Official Bot permissions use OpenIDs, not numeric QQ accounts.
QQ_ADMIN_IDS=
QQ_IS_SANDBOX=false
QQ_API_BASE=https://api.sgroup.qq.com
GSCORE_QQOFFICIAL_IMAGE=nag-gscore-qqofficial:0.7.0-2d582f6
GSCORE_QQOFFICIAL_BUILD_CONTEXT=https://github.com/An-Sun110/gscore-qqofficial.git#2d582f6478a0c0d94aa31d7151c0acabce65ea21

# GsCore's current Docker docs use the CNB image above. Older Docker Hub image:
# GSCORE_IMAGE=lilixxs666/gsuid-core:dev
#
# If pulling the AstrBot image is slow in China, try:
# ASTRBOT_IMAGE=m.daocloud.io/docker.io/soulter/astrbot:latest

ASTRBOT_GSCORE_ADAPTER_REPO=https://github.com/KimigaiiWuyi/astrbot_plugin_gscore_adapter.git
XUTHERINGWAVESUID_REPO=https://github.com/Loping151/XutheringWavesUID.git
ROVERSIGN_REPO=https://github.com/Loping151/RoverSign.git
SCOREECHO_REPO=https://github.com/Loping151/ScoreEcho.git

# CNB mirrors can speed up GsCore plugin initialization in China:
# XUTHERINGWAVESUID_REPO=https://cnb.cool/gscore-mirror/XutheringWavesUID
# ROVERSIGN_REPO=https://cnb.cool/gscore-mirror/RoverSign
# SCOREECHO_REPO=https://cnb.cool/gscore-mirror/ScoreEcho

GSCORE_PYTHON_INDEX=https://pypi.org/simple/
UV_NO_CONFIG=0
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
GSCORE_XWUID_PYTHON_PACKAGES=playwright opencv-python fonttools pypinyin

# Enable these if containers need a proxy for GitHub / PyPI.
# GSCORE_HTTP_PROXY=http://host.docker.internal:7890
# GSCORE_HTTPS_PROXY=http://host.docker.internal:7890
# GSCORE_NO_PROXY=localhost,127.0.0.1,gscore,astrbot,napcat,.local,cnb.cool,mirrors.aliyun.com,pypi.tuna.tsinghua.edu.cn,mirrors.volces.com
