# NAG runtime data.
# Do not put runtime data inside the Git repository.
DATA_ROOT=/opt/nag-data

# Bind WebUIs to localhost by default. Use SSH tunnel, reverse proxy, or change
# this to 0.0.0.0 only after opening the firewall/security group intentionally.
BIND_IP=127.0.0.1

TZ=Asia/Shanghai

GSCORE_PORT=8765
ASTRBOT_WEBUI_PORT=6185
NAPCAT_WEBUI_PORT=6099

# Root deployments can keep 0:0. Non-root deployments should use `id -u` and
# `id -g` from the host user that owns DATA_ROOT.
NAPCAT_UID=0
NAPCAT_GID=0

GSCORE_IMAGE=docker.cnb.cool/gscore-mirror/gsuid_core:latest
ASTRBOT_IMAGE=soulter/astrbot:latest
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest

# GsCore's current Docker docs use the CNB image above. Older Docker Hub image:
# GSCORE_IMAGE=lilixxs666/gsuid-core:dev
#
# If pulling the AstrBot image is slow in China, try:
# ASTRBOT_IMAGE=m.daocloud.io/docker.io/soulter/astrbot:latest

ASTRBOT_GSCORE_ADAPTER_REPO=https://github.com/KimigaiiWuyi/astrbot_plugin_gscore_adapter.git
XUTHERINGWAVESUID_REPO=https://github.com/Loping151/XutheringWavesUID.git
ROVERSIGN_REPO=https://github.com/Loping151/RoverSign.git
SCOREECHO_REPO=https://github.com/Loping151/ScoreEcho.git

# CNB mirrors can speed up GsCore plugin initialization in China:
# XUTHERINGWAVESUID_REPO=https://cnb.cool/gscore-mirror/XutheringWavesUID
# ROVERSIGN_REPO=https://cnb.cool/gscore-mirror/RoverSign
# SCOREECHO_REPO=https://cnb.cool/gscore-mirror/ScoreEcho

GSCORE_PYTHON_INDEX=https://pypi.org/simple/
UV_NO_CONFIG=0

# Enable these if containers need a proxy for GitHub / PyPI.
# GSCORE_HTTP_PROXY=http://host.docker.internal:7890
# GSCORE_HTTPS_PROXY=http://host.docker.internal:7890
# GSCORE_NO_PROXY=localhost,127.0.0.1,gscore,astrbot,napcat,.local,cnb.cool,mirrors.aliyun.com,pypi.tuna.tsinghua.edu.cn,mirrors.volces.com
